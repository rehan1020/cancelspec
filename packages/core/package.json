{
  "name": "@cancelspec/core",
  "version": "0.0.0",
  "description": "Playbook loader, normalization, alias index, scoring, and bundle writer",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./normalize": {
      "types": "./dist/normalize.d.ts",
      "import": "./dist/normalize.js"
    },
    "./index_builder": {
      "types": "./dist/index_builder.d.ts",
      "import": "./dist/index_builder.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@cancelspec/spec": "*",
    "yaml": "2.9.1"
  }
}
