{
  "name": "cancelspec",
  "version": "0.0.0",
  "private": true,
  "description": "Free, open-source, browser-only subscription cancellation tool and community dataset",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/spec",
    "packages/core",
    "packages/scanner",
    "packages/ui",
    "packages/site-builder",
    "packages/cli"
  ],
  "scripts": {
    "build": "tsc --build",
    "pretest": "npm run build",
    "build:site": "node packages/cli/dist/cli.js build --site",
    "serve": "node scripts/serve.js",
    "preview": "npm run build && npm run build:site && npm run serve",
    "test": "npm run test --workspaces --if-present && vitest run tests",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "tsc --build && npm run typecheck --workspaces --if-present",
    "clean": "tsc --build --clean"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.6",
    "axe-core": "4.14.0",
    "esbuild": "0.28.2",
    "jsdom": "29.1.1",
    "playwright": "1.65.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
